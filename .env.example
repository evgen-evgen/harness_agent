# LiteLLM model override. If empty, agent.yaml model is used.
LITELLM_MODEL=

# Optional LiteLLM request-level override for OpenAI-compatible gateways/proxies.
# For normal OpenAI/Anthropic usage, provider-specific keys below are enough.
LITELLM_API_KEY=
LITELLM_API_BASE=
LITELLM_API_VERSION=

# Provider keys used by LiteLLM, depending on selected model.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# UI/channel connector.
DEFAULT_CHANNEL=telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_THINKING_MESSAGE=Думаю...

# Web search tool provider. Set one.
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=

# Local runtime storage paths.
METRICS_PATH=runs/metrics.jsonl
CACHE_PATH=runs/cache.json
CACHE_TTL_SECONDS=3600
WEB_SEARCH_CACHE_TTL_SECONDS=900
MEMORY_PATH=runs/memory.jsonl
SESSION_PATH=runs/sessions.json
SCHEDULER_PATH=runs/scheduled_tasks.json
SCHEDULER_POLL_SECONDS=10

# Filesystem tool root. Filesystem tool cannot access paths outside this directory.
FILE_WORKSPACE_ROOT=agent_workspace
